datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Application {
  id          Int      @id @default(autoincrement())
  jobId       String
  candidateId String
  recruiterId String
  coverLetter String
  createdAt   DateTime @default(now())

  @@map("applications")
}
